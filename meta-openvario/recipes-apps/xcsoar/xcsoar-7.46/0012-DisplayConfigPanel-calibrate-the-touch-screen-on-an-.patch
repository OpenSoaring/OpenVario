From 9f0e71b308d0bd3d9f5319015fd406d23c0ef56a Mon Sep 17 00:00:00 2001
From: Uwe Augustin <Info@FlapsOnline.de>
Date: Tue, 6 Oct 2026 17:48:15 +0200
Subject: [PATCH 12/22] DisplayConfigPanel: calibrate the touch screen on an
 OpenVario

On an OpenVario, the touch screen is calibrated by a script of the
image, and until now a pilot had to quit XCSoar and use the menu of
the image for it.  The Display page already holds the orientation,
which the calibration depends on, so the calibration gets a button
there instead of a page of its own.  The button is only added when
the program runs on an OpenVario, and it is the last row, so that the
row indices of the other settings do not depend on it.
---
 build/main.mk                                      |  5 +++--
 src/Dialogs/Settings/Panels/DisplayConfigPanel.cpp | 14 ++++++++++++++
 2 files changed, 17 insertions(+), 2 deletions(-)

diff --git a/build/main.mk b/build/main.mk
index 9e6eb0bf8..b8d35a56b 100644
--- a/build/main.mk
+++ b/build/main.mk
@@ -840,7 +840,9 @@ ifeq ($(TARGET_IS_LINUX)$(TARGET_IS_KOBO)$(TARGET_IS_ANDROID),ynn)
 XCSOAR_SOURCES += \
 	$(SRC)/Dialogs/Settings/Panels/SystemdConfigPanel.cpp \
 	$(SRC)/Linux/SystemdServiceList.cpp \
-	$(SRC)/OV/System.cpp
+	$(SRC)/Dialogs/ProcessDialog.cpp \
+	$(SRC)/OV/System.cpp \
+	$(SRC)/OV/Calibrate.cpp
 
 ifeq ($(USE_POLL_EVENT),y)
 SYSTEM_TOOLS_DIRECTORY ?= /usr/libexec/xcsoar/system-tools
@@ -849,7 +851,6 @@ XCSOAR_CPPFLAGS += \
 	-DSYSTEM_TOOLS_DIRECTORY=\"$(SYSTEM_TOOLS_DIRECTORY)\" \
 	-DLOCAL_SYSTEM_TOOLS_DIRECTORY=\"$(LOCAL_SYSTEM_TOOLS_DIRECTORY)\"
 XCSOAR_SOURCES += \
-	$(SRC)/Dialogs/ProcessDialog.cpp \
 	$(SRC)/Dialogs/Settings/Panels/SystemToolsPanel.cpp \
 	$(SRC)/SystemTools.cpp
 endif
diff --git a/src/Dialogs/Settings/Panels/DisplayConfigPanel.cpp b/src/Dialogs/Settings/Panels/DisplayConfigPanel.cpp
index 4148f70ff..edeb4ec48 100644
--- a/src/Dialogs/Settings/Panels/DisplayConfigPanel.cpp
+++ b/src/Dialogs/Settings/Panels/DisplayConfigPanel.cpp
@@ -35,7 +35,9 @@
 #endif
 
 #if defined(__linux__) && !defined(__ANDROID__) && !defined(KOBO)
+#include "OV/Calibrate.hpp"
 #include "OV/System.hpp"
+#include "ui/event/Globals.hpp"
 #endif
 
 #include <memory>
@@ -340,6 +342,18 @@ DisplayConfigPanel::Prepare(ContainerWindow &parent,
   AddBoolean(_("Invert cursor color"), _("Enable black cursor"),
              ui_settings.display.invert_cursor_colors);
 #endif
+
+#if defined(__linux__) && !defined(__ANDROID__) && !defined(KOBO)
+  /* the touch screen of an OpenVario is calibrated by a script of the
+     image; the button sits here because the calibration belongs to
+     the screen, and it is the last row so that the indices above do
+     not depend on it */
+  if (IsOpenVario())
+    AddButton(_("Calibrate touch screen"), []{
+      CalibrateTouch(UIGlobals::GetMainWindow().GetDisplay(),
+                     *UI::event_queue);
+    });
+#endif
 }
 
 bool
