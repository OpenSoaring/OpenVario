     auto connection = ODBus::Connection::GetSystemPrivate();
@@ -57,12 +374,23 @@ public:
 
     const ODBus::ScopeMatch match{connection, Systemd::job_removed_match};
 
+    /* journal entries of earlier runs are not part of the answer;
